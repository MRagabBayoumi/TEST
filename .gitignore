# Python virtual environment
venv/
.venv/
env/
ENV/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment variables & secrets
.env
.env.local

# Storage contents (ignore uploads, processed results, logs, and heavy OCR models)
storage/uploads/*
!storage/uploads/.gitkeep
storage/processed/*
!storage/processed/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/tessdata/*
!storage/tessdata/.gitkeep

# OS files
.DS_Store
Thumbs.db
